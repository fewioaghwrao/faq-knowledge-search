        <mxCell id="histories" value="&lt;div style=&quot;font-size:14px;font-weight:bold;color:white;text-align:center;padding:4px;background-color:#8064A2;&quot;&gt;AiSearchHistories&lt;/div&gt;&lt;div style=&quot;font-size:12px;line-height:1.75;padding:8px;text-align:left;&quot;&gt;PK Id : bigint&lt;br&gt;Question : varchar(500)&lt;br&gt;Answer : longtext?&lt;br&gt;IsSuccess : tinyint(1)&lt;br&gt;ErrorMessage : varchar(2000)?&lt;br&gt;ModelName : varchar(100)&lt;br&gt;UsedExternalAi : tinyint(1)&lt;br&gt;WasHelpful : tinyint(1)?&lt;br&gt;CreatedAt : datetime(6)&lt;/div&gt;" style="html=1;whiteSpace=wrap;rounded=0;strokeColor=#404040;fillColor=#E4DFEC;verticalAlign=top;align=left;spacing=0;overflow=hidden;" vertex="1" parent="1">
